<Window x:Class="WebStream.StationSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SearchWindowTitle}" Height="560" Width="880" MinHeight="470" MinWidth="760"
        Icon="Assets/webstream.ico"
        Background="{StaticResource Surface}" Foreground="White" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchTextBox" VerticalContentAlignment="Center" FontSize="14"
               KeyDown="SearchTextBox_KeyDown"
               ToolTip="{DynamicResource SearchInputToolTip}" />
      <Button Grid.Column="2" x:Name="SearchButton" Content="{DynamicResource TabSearch}" Padding="18,9"
              Background="#0B86D1" Click="SearchButton_Click" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="{DynamicResource SearchPlay}" Padding="16,9" Click="PlaySelectedButton_Click" />
      <Button Grid.Column="2" Content="{DynamicResource SearchPause}" Padding="16,9" Click="PauseButton_Click" />
      <Button Grid.Column="4" Content="{DynamicResource SearchStop}" Padding="16,9" Click="StopPreviewButton_Click" />
      <Slider x:Name="PreviewVolumeSlider" Grid.Column="6" Minimum="0" Maximum="100" Value="40"
              VerticalAlignment="Center" ValueChanged="PreviewVolumeSlider_ValueChanged" />
      <Button Grid.Column="8" x:Name="PreviewMuteButton" Content="{DynamicResource MuteOn}" Padding="14,9" Click="PreviewMuteButton_Click" />
    </Grid>

    <Border Grid.Row="4" Background="#202226" BorderBrush="#3A404A" BorderThickness="1" Padding="10">
      <Grid>
        <ListBox x:Name="StationsListBox" Background="Transparent" BorderThickness="0" Foreground="White"
                 SelectionChanged="StationsListBox_SelectionChanged"
                 MouseDoubleClick="StationsListBox_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding VotesText}" Foreground="#FFD85A" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="SearchStatusText" Text="{DynamicResource SearchPrompt}"
                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="6" Background="{StaticResource Panel}" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource SearchDirectUrl}" FontWeight="Bold" />
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SelectedUrlTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
          <Button Grid.Column="2" Content="{DynamicResource SearchAdd}" Padding="18,9" Background="#0B86D1" Click="AddButton_Click" />
          <Button Grid.Column="4" Content="{DynamicResource SearchClose}" Padding="18,9" Click="CloseButton_Click" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
